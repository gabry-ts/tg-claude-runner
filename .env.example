# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER=your_telegram_user_id_here

# Optional — host folder bind-mounted at /home/node inside the container.
# Stores all CLI credentials & user-installed binaries (gh, aws, gcloud,
# .ssh, .gitconfig, .claude/.credentials.json, npm-global, …).
# Defaults to ~/claude_bot. Workspace lives at $CLAUDE_BOT_HOME/workspace.
# CLAUDE_BOT_HOME=/absolute/path/to/claude_bot

# Optional — seconds before a Claude call times out (default 180)
# CLAUDE_TIMEOUT=180

# Optional — enables Whisper transcription of voice/audio messages.
# Without this, voice messages are ignored.
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1
