# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER=your_telegram_user_id_here

# Optional — host folder bind-mounted at /home/node inside the container.
# Stores all CLI credentials & user-installed binaries (gh, aws, gcloud,
# .ssh, .gitconfig, .claude/.credentials.json, npm-global, …).
# Defaults to ~/claude_bot. Workspace lives at $CLAUDE_BOT_HOME/workspace.
# CLAUDE_BOT_HOME=/absolute/path/to/claude_bot

# Optional — enables OpenAI features: Whisper transcription of voice/audio
# messages, spoken (TTS) replies to voice messages, and /img image generation.
# Without this, voice messages are ignored and /img is disabled.
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1          # transcription model
# TGCR_TTS=1                       # 0 disables spoken replies to voice messages
# TTS_MODEL=gpt-4o-mini-tts        # OpenAI TTS model
# TTS_VOICE=alloy                  # OpenAI TTS voice
# IMAGE_MODEL=gpt-image-1          # OpenAI image model for /img (e.g. dall-e-3)

# Optional — Claude session tuning. Defaults are sensible.
# TGCR_RESPONSE_TIMEOUT=0          # max seconds per turn; 0 = no timeout (/cancel to stop)
# TGCR_CLAUDE_BIN=claude           # path to the Claude Code binary
# TGCR_TZ=Europe/Rome              # timezone for /schedule cron evaluation
